{
  "name": "astrelune",
  "version": "1.0.0",
  "private": true,
  "packageManager": "pnpm@10.18.1",
  "engines": {
    "node": ">=20.19.0"
  },
  "workspaces": [
    "apps/api",
    "apps/web",
    "packages/validation"
  ],
  "scripts": {
    "dev": "pnpm --parallel --filter @astrelune/api --filter @astrelune/web dev",
    "dev:api": "pnpm --filter @astrelune/api dev",
    "dev:web": "pnpm --filter @astrelune/web dev",
    "build": "pnpm --filter @astrelune/validation build && pnpm --filter @astrelune/web build",
    "db:generate": "prisma generate",
    "db:migrate": "prisma migrate dev",
    "db:deploy": "prisma migrate deploy",
    "db:health": "node apps/api/src/db-health.js",
    "lint": "eslint .",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "typecheck": "pnpm --filter @astrelune/web typecheck && pnpm --filter @astrelune/validation build",
    "build:validation": "tsc -p packages/validation/tsconfig.json",
    "test": "pnpm test:api && pnpm test:validation",
    "pretest:validation": "pnpm --filter @astrelune/validation build",
    "test:validation": "node --test packages/validation/test/*.test.js",
    "test:api": "node --test apps/api/test/health.test.js apps/api/test/password.test.js apps/api/test/registration.test.js apps/api/test/auth.test.js apps/api/test/session.test.js apps/api/test/sessions.test.js apps/api/test/authentication.test.js apps/api/test/security.test.js apps/api/test/ownership.test.js apps/api/test/projects.test.js",
    "pretest:integration": "pnpm --filter @astrelune/validation build",
    "test:integration": "node --test apps/api/test/*.integration.test.js",
    "test:e2e": "playwright test"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@playwright/test": "^1.64.1",
    "@prisma/client": "6.19.3",
    "@tailwindcss/vite": "^4.3.3",
    "eslint": "^10.13.0",
    "eslint-plugin-react-hooks": "^7.1.1",
    "eslint-plugin-react-refresh": "^0.4.26",
    "globals": "^15.15.0",
    "prettier": "^3.9.10",
    "prisma": "6.19.3",
    "tailwindcss": "^4.3.3",
    "typescript": "5.9.3",
    "typescript-eslint": "^8.72.1"
  }
}
