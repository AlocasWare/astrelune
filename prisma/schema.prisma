generator client {
  provider = "prisma-client-js"
  output   = "../apps/api/src/generated/prisma"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum ProjectStatus {
  ACTIVE
  ARCHIVED
}

enum DocumentKind {
  FOLDER
  CHAPTER
  SCENE
  NOTE
  RESEARCH
}

enum RevisionReason {
  AUTOSAVE_CHECKPOINT
  MANUAL_CHECKPOINT
  RESTORE
}

enum ThemePreference {
  SYSTEM
  LIGHT
  DARK
}

enum WorldEntryKind {
  CHARACTER
  LOCATION
  ORGANIZATION
  OBJECT
  EVENT
  SPECIES
  CONCEPT
  CUSTOM
}

enum WritingPeriod {
  DAILY
  WEEKLY
}

model User {
  id              String    @id @default(uuid()) @db.Uuid
  email           String    @unique @db.VarChar(320)
  passwordHash    String    @db.VarChar(255)
  displayName     String    @db.VarChar(80)
  createdAt       DateTime  @default(now()) @db.Timestamptz(3)
  updatedAt       DateTime  @updatedAt @db.Timestamptz(3)
  emailVerifiedAt DateTime? @db.Timestamptz(3)
  disabledAt      DateTime? @db.Timestamptz(3)

  sessions        Session[]
  preferences     UserPreferences?
  projects        Project[]
  worlds          World[]
  revisions       DocumentRevision[]
  writingGoals    WritingGoal[]
  writingActivity WritingActivity[]

  @@index([createdAt])
}

model Session {
  id         String    @id @default(uuid()) @db.Uuid
  userId     String    @db.Uuid
  tokenHash  String    @unique @db.VarChar(255)
  createdAt  DateTime  @default(now()) @db.Timestamptz(3)
  expiresAt  DateTime  @db.Timestamptz(3)
  lastSeenAt DateTime  @default(now()) @db.Timestamptz(3)
  revokedAt  DateTime? @db.Timestamptz(3)

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, expiresAt])
  @@index([expiresAt])
}

model UserPreferences {
  userId           String          @id @db.Uuid
  theme            ThemePreference @default(SYSTEM)
  editorFontFamily String          @default("serif") @db.VarChar(40)
  editorFontSize   Int             @default(18)
  editorLineHeight Float           @default(1.7)
  focusModeDefault Boolean         @default(false)
  updatedAt        DateTime        @updatedAt @db.Timestamptz(3)

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model Project {
  id          String        @id @default(uuid()) @db.Uuid
  ownerId     String        @db.Uuid
  title       String        @db.VarChar(200)
  description String?       @db.VarChar(2000)
  status      ProjectStatus @default(ACTIVE)
  createdAt   DateTime      @default(now()) @db.Timestamptz(3)
  updatedAt   DateTime      @updatedAt @db.Timestamptz(3)
  archivedAt  DateTime?     @db.Timestamptz(3)

  owner              User              @relation(fields: [ownerId], references: [id], onDelete: Restrict)
  documents          Document[]
  worlds             ProjectWorld[]
  goals              WritingGoal[]
  activity           WritingActivity[]

  @@index([ownerId, status, updatedAt])
}

model Document {
  id                   String       @id @default(uuid()) @db.Uuid
  projectId            String       @db.Uuid
  parentId             String?      @db.Uuid
  title                String       @db.VarChar(200)
  kind                 DocumentKind
  position             Int          @default(0)
  content              Json?        @db.JsonB
  contentSchemaVersion Int          @default(1)
  plainText            String       @default("")
  wordCount            Int          @default(0)
  contentVersion       Int          @default(0)
  createdAt            DateTime     @default(now()) @db.Timestamptz(3)
  updatedAt            DateTime     @updatedAt @db.Timestamptz(3)
  deletedAt            DateTime?    @db.Timestamptz(3)

  project Project @relation(fields: [projectId], references: [id], onDelete: Cascade)

  parent Document? @relation("DocumentTree", fields: [parentId], references: [id], onDelete: Restrict)

  children Document[] @relation("DocumentTree")

  revisions    DocumentRevision[]
  worldEntries DocumentWorldEntry[]
  activity     WritingActivity[]

  @@index([projectId, parentId, position])
  @@index([projectId, updatedAt])
  @@index([parentId])
}

model DocumentRevision {
  id                   String         @id @default(uuid()) @db.Uuid
  documentId           String         @db.Uuid
  revisionNumber       Int
  content              Json           @db.JsonB
  plainText            String
  wordCount            Int
  contentSchemaVersion Int            @default(1)
  documentVersion      Int            @default(0)
  createdAt            DateTime       @default(now()) @db.Timestamptz(3)
  createdById          String?        @db.Uuid
  requestKey           String?        @db.VarChar(128)
  reason               RevisionReason

  document Document @relation(fields: [documentId], references: [id], onDelete: Cascade)

  createdBy User? @relation(fields: [createdById], references: [id], onDelete: SetNull)

  @@unique([documentId, revisionNumber])
  @@unique([documentId, requestKey])
  @@index([documentId, createdAt])
}

model World {
  id          String   @id @default(uuid()) @db.Uuid
  ownerId     String   @db.Uuid
  name        String   @db.VarChar(200)
  description String?  @db.VarChar(4000)
  createdAt   DateTime @default(now()) @db.Timestamptz(3)
  updatedAt   DateTime @updatedAt @db.Timestamptz(3)

  owner    User           @relation(fields: [ownerId], references: [id], onDelete: Restrict)
  projects ProjectWorld[]
  entries  WorldEntry[]

  @@index([ownerId, updatedAt])
}

model ProjectWorld {
  projectId String   @db.Uuid
  worldId   String   @db.Uuid
  createdAt DateTime @default(now()) @db.Timestamptz(3)

  project Project @relation(fields: [projectId], references: [id], onDelete: Cascade)

  world World @relation(fields: [worldId], references: [id], onDelete: Cascade)

  @@id([projectId, worldId])
  @@index([worldId])
}

model WorldEntry {
  id                   String         @id @default(uuid()) @db.Uuid
  worldId              String         @db.Uuid
  parentId             String?        @db.Uuid
  name                 String         @db.VarChar(200)
  kind                 WorldEntryKind
  summary              String?        @db.VarChar(2000)
  content              Json           @db.JsonB
  contentSchemaVersion Int            @default(1)
  createdAt            DateTime       @default(now()) @db.Timestamptz(3)
  updatedAt            DateTime       @updatedAt @db.Timestamptz(3)

  world World @relation(fields: [worldId], references: [id], onDelete: Cascade)

  parent WorldEntry? @relation("WorldEntryTree", fields: [parentId], references: [id], onDelete: Restrict)

  children WorldEntry[] @relation("WorldEntryTree")

  outgoing      WorldEntryRelationship[] @relation("RelationshipSource")
  incoming      WorldEntryRelationship[] @relation("RelationshipTarget")
  documentLinks DocumentWorldEntry[]

  @@index([worldId, parentId, name])
  @@index([worldId, kind])
}

model WorldEntryRelationship {
  id               String   @id @default(uuid()) @db.Uuid
  sourceEntryId    String   @db.Uuid
  targetEntryId    String   @db.Uuid
  relationshipType String   @db.VarChar(80)
  description      String?  @db.VarChar(2000)
  createdAt        DateTime @default(now()) @db.Timestamptz(3)

  sourceEntry WorldEntry @relation("RelationshipSource", fields: [sourceEntryId], references: [id], onDelete: Cascade)

  targetEntry WorldEntry @relation("RelationshipTarget", fields: [targetEntryId], references: [id], onDelete: Cascade)

  @@unique([sourceEntryId, targetEntryId, relationshipType])
  @@index([targetEntryId])
}

model DocumentWorldEntry {
  documentId       String   @db.Uuid
  worldEntryId     String   @db.Uuid
  relationshipType String   @default("REFERENCES") @db.VarChar(40)
  createdAt        DateTime @default(now()) @db.Timestamptz(3)

  document Document @relation(fields: [documentId], references: [id], onDelete: Cascade)

  worldEntry WorldEntry @relation(fields: [worldEntryId], references: [id], onDelete: Cascade)

  @@id([documentId, worldEntryId, relationshipType])
  @@index([worldEntryId])
}

model WritingGoal {
  id          String        @id @default(uuid()) @db.Uuid
  userId      String        @db.Uuid
  projectId   String?       @db.Uuid
  period      WritingPeriod
  targetWords Int
  startsAt    DateTime      @db.Date
  endsAt      DateTime?     @db.Date
  createdAt   DateTime      @default(now()) @db.Timestamptz(3)
  updatedAt   DateTime      @updatedAt @db.Timestamptz(3)

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  project Project? @relation(fields: [projectId], references: [id], onDelete: Cascade)

  @@index([userId, period, startsAt])
  @@index([projectId])
}

model WritingActivity {
  id             String   @id @default(uuid()) @db.Uuid
  userId         String   @db.Uuid
  projectId      String?  @db.Uuid
  documentId     String?  @db.Uuid
  idempotencyKey String   @db.VarChar(128)
  activityDate   DateTime @db.Date
  wordsAdded     Int      @default(0)
  createdAt      DateTime @default(now()) @db.Timestamptz(3)

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  project Project? @relation(fields: [projectId], references: [id], onDelete: SetNull)

  document Document? @relation(fields: [documentId], references: [id], onDelete: SetNull)

  @@unique([userId, documentId, idempotencyKey])
  @@index([userId, activityDate])
  @@index([projectId, activityDate])
  @@index([documentId, activityDate])
}

// Metadata-only outbox entries; deliberately has no user foreign key so account deletion is auditable.
model OperationalEvent {
  id           String   @id @default(uuid()) @db.Uuid
  actorUserId  String?  @db.Uuid
  eventType    String   @db.VarChar(80)
  resourceType String   @db.VarChar(40)
  resourceId   String?  @db.Uuid
  createdAt    DateTime @default(now()) @db.Timestamptz(3)

  @@index([resourceType, resourceId, createdAt])
  @@index([actorUserId, createdAt])
}

